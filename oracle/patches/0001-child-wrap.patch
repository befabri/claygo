 CLAY__ARRAY_DEFINE(Clay__WrappedTextLine, Clay__WrappedTextLineArray)
 
+// claygo extension: child wrap (docs/child-wrap-spec.md, wrapchildren.go). One run of
+// children that share a line (row wrap) or a column (column wrap) of a parent
+// declared with layout.wrapChildren. Lines are contiguous child ranges that
+// together cover every child; exiting children never break a line and add
+// nothing to it, but stay inside the range they fall in.
+typedef struct {
+    int32_t start;       // child offset of the first child in the line
+    int32_t count;       // children [start, start + count), exiting ones included
+    float contentSize;   // wrap-axis content at pack time: live child sizes plus gaps
+    float naturalExtent; // cross axis: the largest live child in the line
+    float extent;        // cross axis: naturalExtent plus this line's share of the parent's slack
+} Clay__WrapLine;
+
+CLAY__ARRAY_DEFINE(Clay__WrapLine, Clay__WrapLineArray)
